# Google OAuth 2.0 "Web application" client, from Google Cloud Console
# (APIs & Services -> Credentials -> Create credentials -> OAuth client ID).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Where Google sends the user back after consent. This string must EXACTLY match
# one of the "Authorized redirect URIs" configured on the OAuth client.
OAUTH_REDIRECT_URI=http://localhost:8790/oauth2callback

# If you host this behind a domain instead of localhost, set PUBLIC_URL and add
# <PUBLIC_URL>/oauth2callback to the client's Authorized redirect URIs. When set,
# OAUTH_REDIRECT_URI defaults to PUBLIC_URL + /oauth2callback.
# PUBLIC_URL=https://hub.example.com

# Port for the built-in auth/status web server.
PORT=8790

# Where refresh tokens are stored (gitignored). Defaults to ./tokens.
# TOKENS_DIR=./tokens

# Set to 1 to NOT start the web auth server (e.g. a second MCP instance that
# should not fight for the port). /auth/<account> is then unavailable.
# DISABLE_AUTH_SERVER=0

# Optional: give an account key its own OAuth client. Needed for a consumer @gmail.com
# account: Google will not let it grant Calendar, Gmail or Drive to an unverified app
# that is "In production", so its keys use a separate project that stays in "Testing"
# (each token then expires 7 days after approval). <KEY> is the accounts.json key
# upper-cased, non-alphanumerics as "_"; both personal keys use the same client:
# GOOGLE_CLIENT_ID_PERSONAL=other-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET_PERSONAL=other-client-secret
# GOOGLE_CLIENT_ID_PERSONAL_DRIVE=other-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET_PERSONAL_DRIVE=other-client-secret

# Optional: send ONE account's Gmail over IMAP with an app password instead of OAuth
# (no 7-day expiry; needs 2-Step Verification). Create it at
# https://myaccount.google.com/apppasswords; spaces are fine.
# GMAIL_APP_PASSWORD_PERSONAL=abcd efgh ijkl mnop

# ---- Hub mode (node src/index.js --http) -----------------------------------
# Only read in hub mode. The hub serves read-only MCP over Streamable HTTP at /mcp
# behind a Cloudflare Tunnel; set PUBLIC_URL above to its public https address.
# Accounts.json keys this hub serves (required in hub mode):
# HUB_ACCOUNTS=personal,personal-drive
# Emails allowed on /admin and the sign-in pages (Cloudflare Access identity).
# Unset = those pages answer 403.
# HUB_ADMIN_EMAILS=you@example.com
# Port and address the hub listens on. Keep 127.0.0.1: only the tunnel should reach it.
# HUB_PORT=8790
# HUB_BIND=127.0.0.1
# Holds keys.json (hashes of caller keys), log/calls.jsonl, log/auth.jsonl and, when
# TOKENS_DIR is not set, tokens/. Defaults to ./data.
# HUB_DATA_DIR=./data
# Minutes between token health probes (also runs once ~5 s after start).
# HUB_PROBE_MINUTES=15
# LOCAL TESTING ONLY: 1 turns the admin gate off. Never behind the tunnel.
# HUB_DEV_NO_ACCESS=0
