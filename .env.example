# Google OAuth 2.0 "Web application" client, from Google Cloud Console
# (APIs & Services -> Credentials -> Create credentials -> OAuth client ID).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Where Google sends the user back after consent. This string must EXACTLY match
# one of the "Authorized redirect URIs" configured on the OAuth client.
OAUTH_REDIRECT_URI=http://localhost:8790/oauth2callback

# If you host this behind a domain instead of localhost, set PUBLIC_URL and add
# <PUBLIC_URL>/oauth2callback to the client's Authorized redirect URIs. When set,
# OAUTH_REDIRECT_URI defaults to PUBLIC_URL + /oauth2callback.
# PUBLIC_URL=https://hub.example.com

# Port for the built-in auth/status web server.
PORT=8790

# Where refresh tokens are stored (gitignored). Defaults to ./tokens.
# TOKENS_DIR=./tokens

# Set to 1 to NOT start the web auth server (e.g. a second MCP instance that
# should not fight for the port). /auth/<account> is then unavailable.
# DISABLE_AUTH_SERVER=0
